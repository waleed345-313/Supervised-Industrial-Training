# =============================================================================
# MongoDB — local instance (mongod on this machine).
#
# URI for the app and for MongoDB Compass (New connection → paste same string).
# Default path: database name after the host (this project uses /test).
# =============================================================================
MONGODB_URI=mongodb://localhost:27017/test

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Port
PORT=5000
